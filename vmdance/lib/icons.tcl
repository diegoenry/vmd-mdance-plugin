#
# VMDance - icons (PNG files in ../icons, generated by icons/make_icons.py)
#

namespace eval ::VMDance::Icons {
    variable dir [file join [file dirname $::VMDance::libdir] icons]
    variable cache
}

# Photo image for an icon at 16, 24 or 32 px; "" if the file is missing, so
# that widgets fall back to their text labels.
proc ::VMDance::Icons::get {name {size 24}} {
    variable dir; variable cache
    set key $name,$size
    if {[info exists cache($key)]} { return $cache($key) }
    set f [file join $dir ${name}_$size.png]
    if {![file readable $f] || [catch {image create photo -file $f} img]} {
        set cache($key) ""
    } else {
        set cache($key) $img
    }
    return $cache($key)
}

# The dimmed variant of an icon (for disabled buttons), or the icon itself.
proc ::VMDance::Icons::dim {name {size 24}} {
    variable dir; variable cache
    set key $name,$size,dim
    if {[info exists cache($key)]} { return $cache($key) }
    set f [file join $dir ${name}_${size}_dim.png]
    if {![file readable $f] || [catch {image create photo -file $f} img]} {
        set cache($key) [get $name $size]
    } else {
        set cache($key) $img
    }
    return $cache($key)
}
